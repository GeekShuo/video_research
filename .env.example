# 至少填一个；不填的 provider 不会被使用
GEMINI_API_KEY=
KIMI_API_KEY=
DEEPSEEK_API_KEY=

# 视觉理解 + 笔记合并用的模型（三选一，写在 VISION_PROVIDER 里）
#   gemini   : VISION_MODEL=gemini-2.5-flash / gemini-2.0-flash
#   kimi     : VISION_MODEL=kimi-k2.6 / kimi-k3（走 OpenAI 兼容接口）
#   deepseek : 文本模型 VISION_MODEL=deepseek-v4-flash / deepseek-v4-pro；
#              视觉模型 DEEPSEEK_VISION_MODEL=deepseek-vl / deepseek-vl-chat（必须分开，文本模型不支持图片）
VISION_PROVIDER=gemini
VISION_MODEL=gemini-2.5-flash
# 仅 deepseek provider 需要：专门的视觉模型（deepseek-v4-flash 是纯文本，传图会报错）
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_API_KEY=

# 阿里百炼语音（ASR paraformer + TTS CosyVoice）
DASHSCOPE_API_KEY=
ALIYUN_TTS_VOICE=longshu_v2
# 本地语音转写模型（faster-whisper，无需 API key）
# 2060 6GB 推荐 medium；显存更紧用 small；想更准用 large-v3（需 ~10GB，2060 跑不动）
WHISPER_MODEL=medium
